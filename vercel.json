{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "mingle-api": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/index.js"
    },
    "mingle-web": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "mingle-api" } },
    { "source": "/(.*)", "destination": { "service": "mingle-web" } }
  ]
}
